@page "/"
@implements IDisposable
@inject EditorState Editor
@inject EditorCommands Commands
@inject ConfirmService Confirm
@inject KeyboardShortcutService Shortcuts
@inject ChangelogService Changelog
@inject FileWarningService FileWarnings
@inject FileDownloadService FileDownload
@inject GameTdbService GameTdb
@inject ToastService Toasts
@inject ILogger<Home> Logger

<PageTitle>R4Everyone</PageTitle>

<div class="app-shell">
    <AppHeaderBar FileName="@Editor.LoadedFileName" HasLoadedFile="Editor.HasLoadedFile" IsDirty="Editor.IsDirty"
                  ErrorCount="Editor.ValidationErrors.Count" OnShowChangelog="OpenChangelog" OnShowAbout="() => _isAboutOpen = true"/>

    <div class="app-body">
        <aside class="app-sidebar">
            <FileControlsPanel CanSave="CanSave"
                               CanExport="HasGames"
                               OnNew="NewFileAsync"
                               OnOpen="OpenFileAsync"
                               OnSave="SaveAsync"
                               OnExportAs="OpenExportModal"
                               OnImportXml="ImportXmlAsync"
                               OnExportXml="ExportXmlAsync"/>

            <ActionsPanel CanUndo="Editor.CanUndo"
                          CanRedo="Editor.CanRedo"
                          CanSortGames="@(Editor.Database?.Games.Count > 1)"
                          CanRemoveGame="CanRemoveGame"
                          Errors="Editor.ValidationErrors"
                          OnUndo="Editor.Undo"
                          OnRedo="Editor.Redo"
                          OnAddGame="AddGame"
                          OnSortGames="Editor.SortGames"
                          OnRemoveGame="RemoveSelectedGameAsync"/>
        </aside>

        <main class="app-main">
            <GameGridView Games="Editor.Database?.Games ?? []" OnGameSelected="OpenGameModal"/>
        </main>
    </div>

    <GameEditorModal Game="_modalGame" OnClose="CloseGameModal"/>

    <ChangelogModal IsOpen="_isChangelogOpen" AppVersion="@Changelog.AppVersion" OnClose="CloseChangelogAsync"/>

        <AboutModal IsOpen="_isAboutOpen" AppVersion="@Changelog.AppVersion" OnClose="() => _isAboutOpen = false"/>
    <UnofficialFileWarningModal IsOpen="_pendingUnofficialOpen != null"
                                FileName="@(_pendingUnofficialOpen?.FileName ?? string.Empty)"
                                OnUnderstood="ContinueUnofficialOpenAsync"
                                OnDontWarnAgain="DisableUnofficialWarningAndContinueAsync"/>

    <EncodingPromptModal IsOpen="_pendingOpen != null"
                         FileName="@(_pendingOpen?.FileName ?? string.Empty)"
                         Marker="@(_pendingOpen?.Marker ?? string.Empty)"
                         OnSelected="OpenPendingFileAsync"
                         OnCancel="CancelPendingOpen"/>

    <M3RealOpenModal IsOpen="_pendingM3Open != null"
                     FileName="@(_pendingM3Open?.FileName ?? string.Empty)"
                     Detected="_pendingM3Open?.Detected"
                     OnSelected="OpenPendingM3FileAsync"
                     OnCancel="CancelPendingM3Open"/>

    <ExportFormatModal IsOpen="_isExportOpen" M3RealDefaults="Editor.M3RealOptions" OnExport="ExportAsync"
                       OnCancel="CloseExportModal"/>
</div>

@code {
    private const long LargeFileThreshold = 5 * 1024 * 1024;

    private bool _isChangelogOpen;
    private bool _isAboutOpen;
    private bool _isExportOpen;

    // The game shown in the editor modal, or null when the modal is closed.
    private R4Game? _modalGame;

    // A file from another tool waiting for the user to acknowledge it may not read properly.
    private PendingUnofficialOpen? _pendingUnofficialOpen;

    // A file waiting for the user to choose an encoding, or null when no prompt is shown.
    private PendingOpen? _pendingOpen;

    // An M3 DS Real file waiting for the user to confirm its settings, or null when no prompt is shown.
    private PendingM3Open? _pendingM3Open;

    private bool CanSave => Editor.HasLoadedFile && Editor.IsDirty && Editor.IsValid;
    private bool CanRemoveGame => Editor.SelectionKind == SelectionKind.Game;
    private bool HasGames => Editor.Database?.Games.Count > 0;

    // Shortcuts are ignored while a dialog is open, so undo cannot change what the dialog is about.
    private bool IsDialogOpen =>
        Confirm.Current != null || _pendingUnofficialOpen != null || _pendingOpen != null || _pendingM3Open != null ||
        _isExportOpen;

    protected override void OnInitialized()
    {
        Editor.StateChanged += HandleStateChanged;
        Shortcuts.UndoRequested += HandleUndoShortcut;
        Shortcuts.RedoRequested += HandleRedoShortcut;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await Shortcuts.RegisterAsync();
        _isChangelogOpen = await Changelog.HasUnseenChangesAsync();

        if (!GameTdb.IsAvailable)
        {
            Toasts.ShowWarning("Cover art is unavailable because the GameTDB database could not be loaded.");
        }

        StateHasChanged();
    }

    private void HandleStateChanged()
    {
        // Close the modal if its game was removed.
        if (_modalGame != null && Editor.Database?.Games.Contains(_modalGame) != true)
        {
            _modalGame = null;
        }

        _ = InvokeAsync(StateHasChanged);
    }

    private void HandleUndoShortcut()
    {
        if (!IsDialogOpen)
        {
            Editor.Undo();
        }
    }

    private void HandleRedoShortcut()
    {
        if (!IsDialogOpen)
        {
            Editor.Redo();
        }
    }

    private void OpenGameModal(R4Game game)
    {
        try
        {
            Editor.Select(SelectionInfo.ForGame(game));
            _modalGame = game;
        }
        catch (InvalidDataException ex)
        {
            Logger.LogError(ex, "Could not read game {GameId}.", game.GameId);
            Toasts.ShowError($"'{EditorState.GetGameDisplayTitle(game)}' could not be read. This part of the file may be corrupt.");
        }
    }

    private void CloseGameModal()
    {
        // Keep the game selected so "Remove Last Edited Game" applies to it.
        if (_modalGame != null)
        {
            Editor.Select(SelectionInfo.ForGame(_modalGame));
        }

        _modalGame = null;
    }

    private void AddGame()
    {
        _modalGame = null;
        Editor.AddGame();
    }

    private async Task RemoveSelectedGameAsync()
    {
        if (Editor.SelectionKind == SelectionKind.Game && Editor.SelectedGame != null)
        {
            await Commands.RemoveGameAsync(Editor.SelectedGame);
        }
    }

    private async Task NewFileAsync()
    {
        if (!await Commands.ConfirmDiscardChangesAsync("Creating a new file"))
        {
            return;
        }

        _modalGame = null;
        Editor.NewFile();
        Toasts.ShowInfo("New file created. Ready to edit!");
    }

    private async Task OpenFileAsync(InputFileChangeEventArgs args)
    {
        var file = args.File;

        // Ask before reading, since reading and parsing a large file can block the browser's only thread.
        if (file.Size > LargeFileThreshold && !await Confirm.AskAsync(new ConfirmRequest("Large file",
                "This is a large file, and your browser may freeze while opening it. Do you wish to continue?",
                "Yes", IsDestructive: false, CancelLabel: "No")))
        {
            Toasts.ShowInfo($"Did not open {file.Name}.");
            return;
        }

        byte[] bytes;
        try
        {
            // The database is parsed lazily from an in-memory copy, so read the whole file.
            await using var stream = file.OpenReadStream(long.MaxValue);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            bytes = buffer.ToArray();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not read {FileName}.", file.Name);
            Toasts.ShowError($"Could not read {file.Name}: {ex.Message}");
            return;
        }

        if (!await Commands.ConfirmDiscardChangesAsync($"Opening {file.Name}"))
        {
            return;
        }

        if (await FileWarnings.ShouldWarnAsync(bytes))
        {
            _pendingUnofficialOpen = new PendingUnofficialOpen(bytes, file.Name);
            return;
        }

        await ContinueOpenAsync(bytes, file.Name);
    }

    private async Task ContinueUnofficialOpenAsync()
    {
        if (_pendingUnofficialOpen is not { } pending)
        {
            return;
        }

        _pendingUnofficialOpen = null;
        await ContinueOpenAsync(pending.File, pending.FileName);
    }

    private async Task DisableUnofficialWarningAndContinueAsync()
    {
        await FileWarnings.DisableUnofficialFileWarningAsync();
        await ContinueUnofficialOpenAsync();
    }

    private async Task ContinueOpenAsync(byte[] bytes, string fileName)
    {
        if (DatabaseFileHeader.HasUnknownEncodingMarker(bytes, out var marker))
        {
            _pendingOpen = new PendingOpen(bytes, fileName, DatabaseFileHeader.FormatMarker(marker));
            return;
        }

        if (R4CheatFormats.Detect(bytes) == R4CheatFormat.M3Real)
        {
            try
            {
                _pendingM3Open = new PendingM3Open(bytes, fileName, R4M3RealDb.Inspect(bytes));
            }
            catch (InvalidDataException ex)
            {
                Logger.LogError(ex, "Could not open {FileName}.", fileName);
                Toasts.ShowError($"Could not open {fileName}: {ex.Message}");
            }

            return;
        }

        await LoadFileAsync(bytes, fileName, encoding: null);
    }

    private async Task OpenPendingM3FileAsync(R4M3RealReadOptions options)
    {
        if (_pendingM3Open is not { } pending)
        {
            return;
        }

        _pendingM3Open = null;
        await LoadFileAsync(pending.File, pending.FileName, encoding: null, options);
    }

    private void CancelPendingM3Open()
    {
        if (_pendingM3Open != null)
        {
            Toasts.ShowInfo($"Did not open {_pendingM3Open.FileName}.");
            _pendingM3Open = null;
        }
    }

    private async Task OpenPendingFileAsync(R4Encoding encoding)
    {
        if (_pendingOpen is not { } pending)
        {
            return;
        }

        _pendingOpen = null;
        await LoadFileAsync(pending.File, pending.FileName, encoding);
    }

    private void CancelPendingOpen()
    {
        if (_pendingOpen != null)
        {
            Toasts.ShowInfo($"Did not open {_pendingOpen.FileName}.");
            _pendingOpen = null;
        }
    }

    private async Task LoadFileAsync(byte[] file, string fileName, R4Encoding? encoding,
        R4M3RealReadOptions? m3RealOptions = null)
    {
        Toasts.ShowInfo($"Opening {fileName}...");
        try
        {
            _modalGame = null;
            await Editor.LoadAsync(file, fileName, encoding, m3RealOptions);
            var opened = $"Opened {fileName} ({Editor.Database?.Games.Count ?? 0} games).";
            if (Editor.FileFormat != R4CheatFormat.R4)
            {
                opened = $"Opened {fileName} as {R4CheatFormats.GetDisplayName(Editor.FileFormat)} ({Editor.Database?.Games.Count ?? 0} games). Saving keeps this format.";
            }

            if (Editor.FileFormat == R4CheatFormat.M3Real)
            {
                opened += " Cheats open turned off because the format doesn't store on/off states.";
            }
            Toasts.ShowInfo(encoding == null ? opened : $"{opened} Save it to write the {encoding} encoding marker.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not open {FileName}.", fileName);
            Toasts.ShowError($"Could not open {fileName}: {ex.Message}");
        }
    }

    private async Task ImportXmlAsync(InputFileChangeEventArgs args)
    {
        var file = args.File;
        try
        {
            await using var stream = file.OpenReadStream(long.MaxValue);
            using var reader = new StreamReader(stream);
            var xml = await reader.ReadToEndAsync();

            if (!await Commands.ConfirmDiscardChangesAsync($"Importing {file.Name}"))
            {
                return;
            }

            _modalGame = null;
            Editor.ImportXml(xml, file.Name);
            Toasts.ShowInfo($"Imported {Editor.Database?.Games.Count ?? 0} games from {file.Name}. Save to create {Editor.SaveFileName}.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not import {FileName}.", file.Name);
            Toasts.ShowError($"Could not import {file.Name}: {ex.Message}");
        }
    }

    private async Task ExportXmlAsync()
    {
        var fileName = Path.ChangeExtension(Editor.SaveFileName, ".xml");
        try
        {
            var xml = Editor.ExportXml();
            await FileDownload.DownloadAsync(fileName, System.Text.Encoding.UTF8.GetBytes(xml), "application/xml");
            Toasts.ShowInfo($"Exported {fileName}.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not export {FileName}.", fileName);
            Toasts.ShowError($"Could not export {fileName}: {ex.Message}");
        }
    }

    private void OpenExportModal()
    {
        if (!Editor.IsValid)
        {
            Toasts.ShowError("Please review any errors before exporting.");
            return;
        }

        _isExportOpen = true;
    }

    private void CloseExportModal()
    {
        _isExportOpen = false;
    }

    private async Task ExportAsync(ExportFormatModal.ExportRequest request)
    {
        _isExportOpen = false;
        var fileName = Editor.GetExportFileName(request.Format);
        try
        {
            var bytes = await Editor.BuildExportBytesAsync(request.Format, request.M3RealOptions);
            WarnAboutOverlongCheats(request.Format);
            await FileDownload.DownloadAsync(fileName, bytes);
            Toasts.ShowInfo($"Exported {fileName} as {R4CheatFormats.GetDisplayName(request.Format)}.");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not export {FileName}.", fileName);
            Toasts.ShowError($"Could not export {fileName}: {ex.Message}");
        }
    }

    // CycloDS Evolution and EDGE carts are thought to reject cheats longer than 255 rows; the file is still written.
    private void WarnAboutOverlongCheats(R4CheatFormat format)
    {
        if (format is not (R4CheatFormat.CycloDsEvolution or R4CheatFormat.Edge))
        {
            return;
        }

        var overlong = Editor.FindOverlongEvolutionCheats();
        if (overlong.Count > 0)
        {
            var (game, cheat) = overlong[0];
            Toasts.ShowWarning(
                $"{overlong.Count} cheat(s), such as '{cheat.Title}' in '{EditorState.GetGameDisplayTitle(game)}', " +
                $"have more than {R4EvolutionCheats.MaxCodeRows} rows and may not work on the cart.");
        }
    }

    private async Task SaveAsync()
    {
        if (!CanSave)
        {
            Toasts.ShowError("Please review any errors before saving.");
            return;
        }

        var fileName = Editor.SaveFileName;
        try
        {
            var bytes = await Editor.BuildSaveBytesAsync();
            WarnAboutOverlongCheats(Editor.FileFormat);
            Toasts.ShowInfo("Beginning download...");
            await FileDownload.DownloadAsync(fileName, bytes);
            Editor.MarkSaved();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not save {FileName}.", fileName);
            Toasts.ShowError($"Could not save {fileName}: {ex.Message}");
        }
    }

    private void OpenChangelog()
    {
        _isChangelogOpen = true;
    }

    private async Task CloseChangelogAsync()
    {
        _isChangelogOpen = false;
        await Changelog.MarkSeenAsync();
    }

    public void Dispose()
    {
        Editor.StateChanged -= HandleStateChanged;
        Shortcuts.UndoRequested -= HandleUndoShortcut;
        Shortcuts.RedoRequested -= HandleRedoShortcut;
    }

    private sealed record PendingUnofficialOpen(byte[] File, string FileName);

    private sealed record PendingOpen(byte[] File, string FileName, string Marker);

    private sealed record PendingM3Open(byte[] File, string FileName, R4M3RealFileInfo Detected);
}
