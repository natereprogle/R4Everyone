@implements IDisposable
@inject ToastService Toasts

<div class="app-toasts" aria-live="polite">
    @foreach (var toast in Toasts.Toasts)
    {
        <div @key="toast.Id" class="app-toast @GetStateClass(toast.State) @(toast.IsClosing ? "is-closing" : string.Empty)"
             role="@(toast.State == ToastState.Error ? "alert" : "status")">
            <div class="app-toast-body">
                <div class="app-toast-label">@GetLabel(toast.State)</div>
                <div class="app-toast-message">@toast.Message</div>
            </div>
            <button type="button" class="app-toast-close" aria-label="Dismiss notification"
                    @onclick="() => Toasts.Dismiss(toast.Id)">&times;</button>
        </div>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        Toasts.ToastsChanged += HandleToastsChanged;
    }

    private void HandleToastsChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private static string GetStateClass(ToastState state) => state switch
    {
        ToastState.Warning => "is-warning",
        ToastState.Error => "is-error",
        _ => "is-info"
    };

    private static string GetLabel(ToastState state) => state switch
    {
        ToastState.Warning => "Warning",
        ToastState.Error => "Error",
        _ => "Info"
    };

    public void Dispose()
    {
        Toasts.ToastsChanged -= HandleToastsChanged;
    }
}
