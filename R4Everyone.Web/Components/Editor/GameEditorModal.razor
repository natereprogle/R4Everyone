@inject EditorState Editor

@if (Game != null)
{
    <div class="game-modal-backdrop" @onclick="OnClose" @onkeydown="HandleKeyDown" tabindex="0" @ref="_overlay">
        <div class="game-modal" @onclick:stopPropagation="true">
            <div class="game-modal-header">
                <div class="modal-title">@EditorState.GetGameDisplayTitle(Game)</div>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="OnClose">Close</button>
            </div>
            <div class="modal-tabs" role="tablist" aria-label="Editor sections">
                @foreach (var (tab, label) in Tabs)
                {
                    <button type="button" role="tab" class="modal-tab @(_tab == tab ? "is-active" : string.Empty)"
                            aria-selected="@(_tab == tab ? "true" : "false")" @onclick="() => _tab = tab">
                        @label
                    </button>
                }
            </div>
            <div class="game-modal-body show-@_tab.ToString().ToLowerInvariant()">
                <div class="card panel-card shadow-sm modal-section modal-section-tree">
                    <div class="card-header">Folders & Cheats</div>
                    <div class="card-body panel-body">
                        <div class="modal-actions action-grid">
                            <button type="button" class="btn btn-success" @onclick="AddFolder">Add Folder</button>
                            <button type="button" class="btn btn-success" @onclick="AddCheat">Add Cheat</button>
                            <button type="button" class="btn btn-danger" @onclick="Editor.RemoveSelectedItem"
                                    disabled="@(Editor.SelectionKind != SelectionKind.Folder)">Remove Folder
                            </button>
                            <button type="button" class="btn btn-danger" @onclick="Editor.RemoveSelectedItem"
                                    disabled="@(Editor.SelectionKind != SelectionKind.Cheat)">Remove Cheat
                            </button>
                            <button type="button" class="btn btn-danger" @onclick="RemoveGame">Remove Game</button>
                        </div>
                        <GameScopedTreeView Game="Game"/>
                    </div>
                </div>
                <div class="card panel-card shadow-sm modal-section modal-section-game">
                    <div class="card-header">Game Details</div>
                    <div class="card-body panel-body">
                        <GameDetailsEditor Game="Game"/>
                    </div>
                </div>
                <div class="card panel-card shadow-sm modal-section modal-section-item">
                    <div class="card-header">Item Details</div>
                    <div class="card-body panel-body">
                        @switch (Editor.SelectionKind)
                        {
                            case SelectionKind.Folder when Editor.SelectedFolder != null:
                                <FolderDetailsEditor Folder="Editor.SelectedFolder"/>
                                break;
                            case SelectionKind.Cheat when Editor.SelectedCheat != null:
                                <CheatDetailsEditor Cheat="Editor.SelectedCheat"/>
                                break;
                            default:
                                <div class="empty-state">Select a folder or cheat to edit.</div>
                                break;
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // On narrow screens only one section is shown at a time; on wider screens all three are visible.
    private enum Tab
    {
        Tree,
        Game,
        Item
    }

    private static readonly (Tab Tab, string Label)[] Tabs =
    [
        (Tab.Tree, "Cheats"),
        (Tab.Game, "Game"),
        (Tab.Item, "Item")
    ];

    private ElementReference _overlay;
    private R4Game? _focusedGame;
    private Tab _tab = Tab.Tree;
    private object? _lastSelectedItem;

    /// <summary>
    /// The game being edited. The modal is open while this is set.
    /// </summary>
    [Parameter] public R4Game? Game { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    protected override void OnParametersSet()
    {
        if (Game == null)
        {
            _tab = Tab.Tree;
            _lastSelectedItem = null;
            return;
        }

        // Show the item editor whenever a different folder or cheat is selected or added.
        var selectedItem = (object?)Editor.SelectedCheat ?? Editor.SelectedFolder;
        if (selectedItem != null && !ReferenceEquals(selectedItem, _lastSelectedItem))
        {
            _tab = Tab.Item;
        }

        _lastSelectedItem = selectedItem;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Focus the overlay when the modal opens so Escape closes it.
        if (Game != null && !ReferenceEquals(_focusedGame, Game))
        {
            _focusedGame = Game;
            await _overlay.FocusAsync();
        }
        else if (Game == null)
        {
            _focusedGame = null;
        }
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            await OnClose.InvokeAsync();
        }
    }

    private void AddFolder()
    {
        Editor.Select(SelectionInfo.ForGame(Game!));
        Editor.AddFolder();
    }

    private void AddCheat()
    {
        // With nothing selected inside the game, add the cheat at the top level.
        if (Editor.SelectedGame == null)
        {
            Editor.Select(SelectionInfo.ForGame(Game!));
        }

        Editor.AddCheat();
    }

    private async Task RemoveGame()
    {
        Editor.RemoveGame(Game!);
        await OnClose.InvokeAsync();
    }
}
