@using R4Everyone.Web.Formatting
@inject EditorState Editor
@inject IJSRuntime Js

<div class="row g-3">
    <div class="col-12">
        <label class="form-label">Title</label>
        <input class="form-control" value="@Cheat.Title"
               @oninput="e => Editor.UpdateCheatTitle(e.Value?.ToString() ?? string.Empty)"/>
    </div>
    <div class="col-12">
        <label class="form-label">Description</label>
        <textarea class="form-control" rows="4"
                  @oninput="e => Editor.UpdateCheatDescription(e.Value?.ToString() ?? string.Empty)">@Cheat.Description</textarea>
    </div>
    <div class="col-12">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" checked="@Cheat.Enabled"
                   @onchange="e => Editor.UpdateCheatEnabled(e.Value is true)"/>
            <label class="form-check-label">Enabled</label>
        </div>
    </div>
</div>

<hr/>

<div class="codes-editor">
    <div class="section-title mb-2">Codes</div>
    @if (Editor.HasActivator(Cheat))
    {
        <div class="activator-notice mb-2">
            This cheat uses an activator! You can edit it here in Codes or with the activator buttons below.
        </div>
    }
    <textarea class="form-control code-input @(_rowErrors.Count > 0 ? "is-invalid" : string.Empty)" rows="6"
              value="@_codeText" @oninput="HandleCodeInputAsync" spellcheck="false"
              @ref="_codeInput"></textarea>
    @if (_rowErrors.Count > 0)
    {
        <div class="invalid-feedback d-block">
            @foreach (var message in _rowErrors)
            {
                <div>@message</div>
            }
        </div>
    }
</div>

<hr/>

<div class="activator-editor">
    <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between mb-2">
        <div>
            <div class="section-title mb-0">Activator</div>
            <div class="activator-subtitle">
                Requires buttons to be held or released for the cheat to run. The state of buttons marked as "Ignore" will not affect activation of the cheat.
            </div>
        </div>
        <div class="form-check form-switch mb-0">
            <input class="form-check-input"
                   type="checkbox"
                   checked="@(ActivatorOptions.XyMode == R4Game.XyActivatorMode.ActionReplay)"
                   @onchange="OnActionReplayCompatChanged"/>
            <label class="form-check-label">
                Action Replay-Compatible
                <span class="activator-info"
                      title="Makes the activator compatible with physical action replay cards and some emulators. Only applies if using X/Y. If you are unsure, leave this off">i</span>
            </label>
        </div>
    </div>

    <div class="activator-button-grid">
        @foreach (var (button, label) in ActivatorButtons)
        {
            var state = ActivatorOptions.ButtonStates.GetValueOrDefault(button, R4Game.ActivatorKeyState.Ignore);
            <button type="button"
                    class="activator-tile @GetStateCssClass(state)"
                    @onclick="() => CycleActivatorState(button)"
                    title="Click to cycle: Ignore -> Hold -> Release">
                <span class="activator-tile-key">@label</span>
                <span class="activator-tile-state">@state</span>
            </button>
        }
    </div>

    <div class="activator-legend">
        Click any button to cycle state: <strong>Ignore</strong> -> <strong>Hold</strong> -> <strong>Release</strong>.
    </div>
</div>

@code {
    private static readonly (R4Game.ActivatorButton Button, string Label)[] ActivatorButtons =
    [
        (R4Game.ActivatorButton.L, "L"),
        (R4Game.ActivatorButton.R, "R"),
        (R4Game.ActivatorButton.A, "A"),
        (R4Game.ActivatorButton.B, "B"),
        (R4Game.ActivatorButton.X, "X"),
        (R4Game.ActivatorButton.Y, "Y"),
        (R4Game.ActivatorButton.Up, "Up"),
        (R4Game.ActivatorButton.Down, "Down"),
        (R4Game.ActivatorButton.Left, "Left"),
        (R4Game.ActivatorButton.Right, "Right"),
        (R4Game.ActivatorButton.Start, "Start"),
        (R4Game.ActivatorButton.Select, "Select")
    ];

    private ElementReference _codeInput;
    private List<string> _rowErrors = [];
    private string _codeText = string.Empty;
    private R4Cheat? _lastCheat;

    // Set while the textarea holds text the user just typed, so it is not overwritten before the caret is restored.
    private (int Start, int End)? _pendingSelection;

    [Parameter, EditorRequired] public R4Cheat Cheat { get; set; } = null!;

    private R4Game.CheatActivatorOptions ActivatorOptions => Editor.GetActivatorOptions(Cheat);

    protected override void OnParametersSet()
    {
        var editorText = Editor.GetCheatCodeText(Cheat);
        var cheatChanged = !ReferenceEquals(_lastCheat, Cheat);
        if (cheatChanged || (_pendingSelection == null && !string.Equals(_codeText, editorText, StringComparison.Ordinal)))
        {
            _lastCheat = Cheat;
            SetCodeText(editorText);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Js.InvokeVoidAsync("r4eCheatEditor.bindHexFilter", _codeInput);
        }

        if (_pendingSelection is var (start, end))
        {
            _pendingSelection = null;
            await Js.InvokeVoidAsync("r4eCheatEditor.setSelection", _codeInput, start, end);
        }
    }

    private async Task HandleCodeInputAsync(ChangeEventArgs args)
    {
        var raw = args.Value?.ToString() ?? string.Empty;
        var selection = await Js.InvokeAsync<TextSelection>("r4eCheatEditor.getSelection", _codeInput);
        var formatted = CheatCodeText.Format(raw, selection.Start, selection.End);

        SetCodeText(formatted.Text);
        _pendingSelection = (formatted.SelectionStart, formatted.SelectionEnd);
        Editor.UpdateCheatCodeText(formatted.Text);
    }

    private void SetCodeText(string text)
    {
        _codeText = text;
        _rowErrors = CheatCodeText.GetRowErrors(text);
    }

    private void OnActionReplayCompatChanged(ChangeEventArgs args)
    {
        var xyMode = args.Value is true ? R4Game.XyActivatorMode.ActionReplay : R4Game.XyActivatorMode.Standard;
        Editor.UpdateActivatorOptions(new R4Game.CheatActivatorOptions(ActivatorOptions.ButtonStates, xyMode));
    }

    private void CycleActivatorState(R4Game.ActivatorButton button)
    {
        var current = ActivatorOptions;
        var states = current.ButtonStates.ToDictionary();
        states[button] = states.GetValueOrDefault(button) switch
        {
            R4Game.ActivatorKeyState.Ignore => R4Game.ActivatorKeyState.Hold,
            R4Game.ActivatorKeyState.Hold => R4Game.ActivatorKeyState.Release,
            _ => R4Game.ActivatorKeyState.Ignore
        };

        Editor.UpdateActivatorOptions(new R4Game.CheatActivatorOptions(states, current.XyMode));
    }

    private static string GetStateCssClass(R4Game.ActivatorKeyState state) => state switch
    {
        R4Game.ActivatorKeyState.Hold => "is-hold",
        R4Game.ActivatorKeyState.Release => "is-release",
        _ => "is-ignore"
    };

    private sealed record TextSelection(int Start, int End);
}
