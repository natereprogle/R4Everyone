@inject EditorState Editor
@inject ToastService Toasts
@inject ILogger<GameDetailsEditor> Logger

<div class="row g-3">
    <div class="col-md-4">
        <label class="form-label">Game ID</label>
        <input class="form-control" maxlength="4" value="@Game.GameId"
               @oninput="e => Editor.UpdateGameId(Game, ValueOf(e))"/>
        <div class="form-text">4 characters. Leave blank if unknown.</div>
    </div>
    <div class="col-md-8">
        <label class="form-label">Title</label>
        <input class="form-control" value="@Game.GameTitle"
               @oninput="e => Editor.UpdateGameTitle(Game, ValueOf(e))"/>
    </div>
    <div class="col-md-4">
        <label class="form-label">Checksum</label>
        <input class="form-control" maxlength="8" value="@Game.GameChecksum"
               @oninput="e => Editor.UpdateGameChecksum(Game, ValueOf(e))"/>
        <div class="form-text">Required. 8 hex characters.</div>
    </div>
    <div class="col-md-4 d-flex align-items-center">
        <div class="form-check mt-md-4">
            <input class="form-check-input" type="checkbox" checked="@Game.GameEnabled"
                   @onchange="e => Editor.UpdateGameEnabled(Game, e.Value is true)"/>
            <label class="form-check-label">Enabled</label>
        </div>
    </div>
    <div class="rom-loader">
        <div class="section-title">Calculate from ROM</div>
        <div class="form-text">If you have a ROM file, you may calculate the Game ID and Checksum by opening it. No data ever leaves your device.</div>
        <label class="btn btn-outline-secondary">
            Select ROM
            <InputFile class="d-none" OnChange="ReadRomHeaderAsync" accept=".nds"/>
        </label>
    </div>
</div>

<hr/>

<div class="mastercodes">
    <div class="section-title">Master Codes</div>
    <div class="mastercode-grid">
        @for (var i = 0; i < EditorState.MasterCodeCount; i++)
        {
            var index = i;
            <input class="form-control code-input" value="@MasterCodes[index]" minlength="8" maxlength="8"
                   aria-label="Master code @(index + 1)"
                   @oninput="e => Editor.UpdateMasterCode(Game, index, ValueOf(e))"/>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public R4Game Game { get; set; } = null!;

    private IReadOnlyList<string> MasterCodes => Editor.GetMasterCodeText(Game);

    private static string ValueOf(ChangeEventArgs args) => args.Value?.ToString() ?? string.Empty;

    private async Task ReadRomHeaderAsync(InputFileChangeEventArgs args)
    {
        var file = args.File;
        try
        {
            // Only the header is read, so ROMs of any size are accepted.
            await using var stream = file.OpenReadStream(long.MaxValue);
            var header = new byte[EditorState.RomHeaderLength];
            var bytesRead = await stream.ReadAtLeastAsync(header, header.Length, throwOnEndOfStream: false);
            Editor.ApplyRomHeader(Game, header[..bytesRead]);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not read the ROM header from {FileName}.", file.Name);
            Toasts.ShowError($"Could not read {file.Name}: {ex.Message}");
        }
    }
}
