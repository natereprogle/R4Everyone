@implements IAsyncDisposable
@inject CoverArtService CoverArt
@inject IJSRuntime Js
@inject ILogger<GameGridView> Logger

<div class="game-grid">
    @if (Games.Count == 0)
    {
        <div class="empty-state">No games yet. Create or open a file to begin.</div>
    }
    else
    {
        @foreach (var game in Games)
        {
            var title = EditorState.GetGameDisplayTitle(game);
            var gameId = game.GameId;
            var cover = GetCover(gameId);
            var isLoading = cover is { IsLoading: true };
            <button type="button" class="game-tile" data-game-id="@gameId"
                    @onclick="() => OnGameSelected.InvokeAsync(game)">
                <div class="game-image-frame">
                    @if (cover is { HasError: true })
                    {
                        <img class="game-tile-image" src="@FailedCoverPath" alt="@title"/>
                    }
                    else if (!string.IsNullOrEmpty(cover?.Url))
                    {
                        <img class="game-tile-image @(isLoading ? "loading" : "")" src="@cover.Url" alt="@title"
                             @onload="() => OnImageLoaded(cover)" @onerror="() => OnImageError(cover)"/>
                    }
                    else
                    {
                        <img class="game-tile-image @(isLoading ? "loading" : "")" src="@UnknownCoverPath"
                             alt="Unknown cover art"/>
                    }
                    @if (isLoading)
                    {
                        <div class="game-image-loading-bar"></div>
                    }
                </div>
                <div class="game-tile-body">
                    <div class="game-tile-title">@title</div>
                    @if (!string.IsNullOrWhiteSpace(gameId))
                    {
                        <div class="game-tile-subtitle">@gameId</div>
                    }
                </div>
            </button>
        }
    }
</div>

@code {
    private const string FailedCoverPath = "assets/failed_cover_fetch.webp";
    private const string UnknownCoverPath = "assets/unknown_game_cover.webp";

    // Stop showing the loading bar if the browser never reports the image as loaded or failed.
    private static readonly TimeSpan ImageLoadTimeout = TimeSpan.FromSeconds(10);

    private readonly Dictionary<string, CoverState> _covers = new(StringComparer.OrdinalIgnoreCase);
    private DotNetObjectReference<GameGridView>? _dotNetRef;

    [Parameter] public IReadOnlyList<R4Game> Games { get; set; } = [];
    [Parameter] public EventCallback<R4Game> OnGameSelected { get; set; }

    protected override void OnParametersSet()
    {
        // Forget covers for games that are no longer in the list, so they are fetched again if re-added.
        var currentIds = Games
            .Select(game => game.GameId)
            .Where(id => !string.IsNullOrWhiteSpace(id))
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        foreach (var gameId in _covers.Keys.Where(id => !currentIds.Contains(id)).ToList())
        {
            _covers.Remove(gameId);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _dotNetRef ??= DotNetObjectReference.Create(this);
        await Js.InvokeVoidAsync("r4eLazyImages.observeAll", _dotNetRef);
    }

    /// <summary>
    /// Called from JS when a tile scrolls into view, to start loading its cover art.
    /// </summary>
    [JSInvokable]
    public void NotifyVisible(string gameId)
    {
        if (string.IsNullOrWhiteSpace(gameId) || _covers.ContainsKey(gameId))
        {
            return;
        }

        var cover = new CoverState();
        _covers[gameId] = cover;
        StateHasChanged();
        _ = LoadCoverAsync(gameId, cover);
    }

    // Never throws: failures are logged and shown as the "failed" placeholder.
    private async Task LoadCoverAsync(string gameId, CoverState cover)
    {
        try
        {
            cover.Url = await CoverArt.FindCoverUrlAsync(gameId);
            if (string.IsNullOrEmpty(cover.Url))
            {
                cover.IsLoaded = true;
            }

            await InvokeAsync(StateHasChanged);
            if (cover.IsLoaded)
            {
                return;
            }

            await Task.Delay(ImageLoadTimeout);
            if (!cover.IsLoaded)
            {
                cover.IsLoaded = true;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not load cover art for game {GameId}.", gameId);
            cover.HasError = true;
            cover.IsLoaded = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private CoverState? GetCover(string? gameId) =>
        !string.IsNullOrWhiteSpace(gameId) && _covers.TryGetValue(gameId, out var cover) ? cover : null;

    private static void OnImageLoaded(CoverState cover)
    {
        cover.IsLoaded = true;
    }

    private void OnImageError(CoverState cover)
    {
        Logger.LogWarning("Cover image {Url} failed to display.", cover.Url);
        cover.HasError = true;
        cover.IsLoaded = true;
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("r4eLazyImages.disconnect");
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "Could not stop observing game tiles.");
        }

        _dotNetRef?.Dispose();
    }

    private sealed class CoverState
    {
        public string? Url { get; set; }
        public bool IsLoaded { get; set; }
        public bool HasError { get; set; }
        public bool IsLoading => !IsLoaded;
    }
}
